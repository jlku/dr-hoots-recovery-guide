  "findings": [
    {
      "id": "seg.incision-day2.title",
      "criterion": "phrasing",
      "problem": "In everyday Mandarin, 第2天 or 第二天 usually means 'the next day', or the 2nd day when surgery day counts as day 1. A patient could read 第2天：拆绷带 as 'remove the bandage the day after surgery', one day earlier than the narration's 手术两天后 (wc.01). This is a timing ambiguity in a wound-care instruction.",
      "suggestion": "手术两天后：拆绷带，看有没有胶布"
    },
    {
      "id": "seg.incision-day2.chip",
      "criterion": "phrasing",
      "problem": "The chip 第2天 has the same ambiguity. It can be read as the day after surgery instead of two days after surgery.",
      "suggestion": "术后2天"
    },
    {
      "id": "seg.next-two-weeks.chip",
      "criterion": "phrasing",
      "problem": "第3天 can be read as the 2nd day after surgery, which conflicts with wc.08 (手术三天后) on when showering may start. 第3天到2周 also pairs an ordinal day with a duration, which reads awkwardly.",
      "suggestion": "术后3天到2周"
    }
  ],
  "verdict": "fail"
