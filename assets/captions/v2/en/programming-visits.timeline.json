      "record_id": "chaptered-programming",
      "manifest": "assets/audio/manifest.json",
      "source_audio": "assets/audio/chaptered-programming.mp3",
      "text": "At this visit, a hearing specialist called an audiologist programs the speech processor you wear outside your ear. The program is made for your needs."
    },
    {
      "id": "beat/follow-up",
      "frame": "frame-14-follow-up",
      "sentence_ids": [
        "act.04",
        "act.05"
