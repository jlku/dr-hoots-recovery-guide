      "record_id": "follow-up",
      "manifest": "assets/audio/manifest.json",
      "source_audio": "assets/audio/follow-up.mp3",
      "text": "At later visits, the team checks the implant and equipment and measures how they are working. You will keep returning for checks and fine-tuning."
    }
