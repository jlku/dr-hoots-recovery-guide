        "act.04",
        "act.05"
      ],
      "start": 19.02,
      "end": 30.38,
      "speech_seconds": 11.36,
      "record_id": "follow-up",
      "manifest": "assets/audio/v2/zh-Hans/narration.json",
      "source_audio": "assets/audio/v2/zh-Hans/beats/follow-up.mp3",
      "text": "以后就诊时，医疗团队会检查植入体和设备，并检测它们的工作情况。您会继续回来做检查和微调。"
    }
  ],
