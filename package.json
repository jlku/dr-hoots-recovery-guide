{
  "name": "dr-hoots-design-study",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "npm run activation:test",
    "check": "npm run content:validate && npm run copy:validate && npm run media:validate && npm run narration:validate && npm run activation:validate:contract && npm run segments:validate && npm run translations:validate && npm run activation:test",
    "segments:validate": "node scripts/validate-segments.mjs --media",
    "segments:build": "node scripts/build-segment-media.mjs",
    "translations:validate": "node scripts/validate-translations.mjs",
    "assets:generate": "node --env-file=.env.local scripts/generate-fal-assets.mjs",
    "narration:generate": "node --env-file=.env.local scripts/generate-fal-narration.mjs",
    "narration:validate": "node scripts/validate-narration.mjs",
    "activation:validate:contract": "node scripts/validate-activation-production.mjs --contract-only",
    "activation:test": "node --test tests/*.test.mjs",
    "activation:scrolly:build": "node scripts/build-activation-scrolly.mjs",
    "activation:spend:authorize": "node scripts/authorize-activation-spend.mjs",
    "activation:host": "node scripts/generate-activation-host.mjs",
    "video:generate": "node --env-file=.env.local scripts/generate-fal-host-video.mjs",
    "content:hashes": "node scripts/validate-canonical-content.mjs --print",
    "content:validate": "node scripts/validate-canonical-content.mjs",
    "copy:validate": "node scripts/validate-copy-adaptations.mjs",
    "media:build": "node scripts/build-media-projections.mjs",
    "media:validate": "node scripts/validate-media-projections.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.0"
  }
}
